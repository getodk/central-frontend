<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:jr="http://openrosa.org/javarosa">
  <h:head>
    <h:title>09 Repeat - field-list</h:title>
    <model>
      <instance>
        <data id="pg_09_repeat_fieldlist">
          <intro/>
          <child jr:template="">
            <cname/>
            <cage/>
            <csex/>
          </child>
          <child>
            <cname/>
            <cage/>
            <csex/>
          </child>
          <child>
            <cname/>
            <cage/>
            <csex/>
          </child>
          <meta>
            <instanceID/>
          </meta>
        </data>
      </instance>
      <bind nodeset="/data/intro" type="string"/>
      <bind nodeset="/data/child/cname" type="string"/>
      <bind nodeset="/data/child/cage" type="int"/>
      <bind nodeset="/data/child/csex" type="string"/>
      <bind nodeset="/data/meta/instanceID" type="string"/>
    </model>
  </h:head>
  <h:body class="pages">
    <input ref="/data/intro"><label>Intro question (own page)</label></input>
    <group ref="/data/child" appearance="field-list">
      <label>Children (each iteration = one page)</label>
      <repeat nodeset="/data/child">
        <input ref="/data/child/cname"><label>Child <output value="position(..)"/> name</label></input>
        <input ref="/data/child/cage"><label>Child <output value="position(..)"/> age</label></input>
        <select1 ref="/data/child/csex">
          <label>Child <output value="position(..)"/> sex</label>
          <item><label>Female</label><value>f</value></item>
          <item><label>Male</label><value>m</value></item>
        </select1>
      </repeat>
    </group>
  </h:body>
</h:html>
